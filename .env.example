# TraceGuard Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Application Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ML Pipeline Configuration (Stages 2-5)
MODEL_ARTIFACTS_DIR=models/artifacts
DATA_DIR=data
ENABLE_ABSTENTION=true
DEFAULT_ABSTENTION_THRESHOLD=0.65
DRIFT_DETECTION_WINDOW=1000

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000
